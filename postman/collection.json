{
  "info": {
    "name": "Match ATS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "List Candidates",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/candidatos"
      }
    },
    {
      "name": "List Jobs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/vagas"
      }
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "https://api.match-ats.com/v1"}
  ]
}
