{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "deno.unstable", "dom", "esnext"]
  },
  "imports": {
    "std/": "https://deno.land/std@0.208.0/"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "options": {
      "singleQuote": true,
      "semiColons": true
    }
  }
}
